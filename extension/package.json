{
  "name": "provenyx-security",
  "displayName": "Provenyx Security",
  "description": "Software dependency trust and supply-chain security analysis",
  "version": "0.1.6",
  "publisher": "OmkarPramodBandikatte",
  "contributors": [
    "Aaditya Shivshankar Jaiswar",
    "Omkar Bandikatte",
    "RONAK PARMAR - 60009230091",
    "VIVEK CHAUHAN - 60009230029"
  ],
  "license": "MIT",
  "private": true,
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "security",
    "supply chain",
    "npm",
    "pnpm",
    "php",
    "composer",
    "dependencies",
    "package-lock"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:package-lock.json",
    "workspaceContains:pnpm-lock.yaml",
    "workspaceContains:yarn.lock",
    "workspaceContains:bun.lock",
    "workspaceContains:composer.lock",
    "workspaceContains:Pipfile.lock",
    "workspaceContains:requirements.txt",
    "workspaceContains:go.sum",
    "workspaceContains:Cargo.lock",
    "workspaceContains:pom.xml",
    "workspaceContains:gradle.lockfile",
    "workspaceContains:packages.lock.json",
    "workspaceContains:Gemfile.lock",
    "workspaceContains:pubspec.lock",
    "workspaceContains:Package.resolved"
  ],
  "contributes": {
    "commands": [
      {
        "command": "provenyx.scanDependencies",
        "title": "Scan Dependencies",
        "category": "Provenyx",
        "icon": "$(play)"
      },
      {
        "command": "provenyx.showFindings",
        "title": "Show Findings",
        "category": "Provenyx"
      },
      {
        "command": "provenyx.openDashboard",
        "title": "Open Dashboard",
        "category": "Provenyx",
        "icon": "$(link-external)"
      },
      {
        "command": "provenyx.checkBackend",
        "title": "Check Backend Connection",
        "category": "Provenyx",
        "icon": "$(refresh)"
      },
      {
        "command": "provenyx.simplifyFindings",
        "title": "Simplify Findings (OpenRouter LLM)",
        "category": "Provenyx",
        "icon": "$(sparkle)"
      },
      {
        "command": "provenyx.signIn",
        "title": "Sign In with GitHub",
        "category": "Provenyx"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "provenyx",
          "title": "Provenyx",
          "icon": "images/sidebar.svg"
        }
      ]
    },
    "views": {
      "provenyx": [
        {
          "id": "provenyx.findings",
          "name": "Findings"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "provenyx.scanDependencies",
          "when": "view == provenyx.findings",
          "group": "navigation@1"
        },
        {
          "command": "provenyx.checkBackend",
          "when": "view == provenyx.findings",
          "group": "navigation@2"
        },
        {
          "command": "provenyx.simplifyFindings",
          "when": "view == provenyx.findings",
          "group": "navigation@3"
        },
        {
          "command": "provenyx.openDashboard",
          "when": "view == provenyx.findings",
          "group": "navigation@4"
        }
      ]
    },
    "configuration": {
      "title": "Provenyx",
      "properties": {
        "provenyx.apiBaseUrl": {
          "type": "string",
          "default": "https://devknights.onrender.com",
          "format": "uri",
          "markdownDescription": "Base URL of the Provenyx API. Lockfiles are only sent here after you confirm each scan."
        },
        "provenyx.apiKey": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Access key for a Provenyx API started with `PROVENYX_API_KEY`. Leave empty for the local development backend."
        },
        "provenyx.dashboardUrl": {
          "type": "string",
          "default": "https://provenyx.vercel.app",
          "format": "uri",
          "markdownDescription": "URL opened by **Provenyx: Open Dashboard**."
        },
        "provenyx.autoScanEnabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "When a supported dependency lockfile is found, created, or changed, start the scan flow automatically. You are still asked to confirm before anything is sent to the API."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "check-types": "tsc --noEmit",
    "compile": "npm run check-types && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "npm run check-types && node esbuild.js --production",
    "vsix": "vsce package --no-dependencies",
    "test:smoke": "npm run compile && node test/runSmoke.js"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/vscode": "1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3"
  },
  "preview": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/aad1tyaaaaa/DevKnights.git",
    "directory": "extension"
  },
  "bugs": {
    "url": "https://github.com/aad1tyaaaaa/DevKnights/issues"
  },
  "homepage": "https://github.com/aad1tyaaaaa/DevKnights/tree/main/extension#readme",
  "galleryBanner": {
    "color": "#173d30",
    "theme": "dark"
  },
  "dependencies": {
    "@yarnpkg/parsers": "^3.1.0",
    "fast-xml-parser": "^5.12.0",
    "jsonc-parser": "^3.3.1",
    "yaml": "^2.9.1"
  }
}
